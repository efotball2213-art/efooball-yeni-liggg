  cs.connect(hp);hp.connect(cg);cg.connect(master);cs.start(t0+fl);
}
function playMusic(){
  if(!MUSIC_ON||VIDEO_SRC)return;
  try{
    if(MUSIC_SRC){mus=new Audio(MUSIC_SRC);mus.volume=.8;var q=mus.play();if(q&&q.catch)q.catch(function(){})}
    else synth();
  }catch(e){}
}
function stopMusic(){
  try{
    if(mus){var v=mus.volume;var iv=setInterval(function(){v-=.1;if(v<=0){clearInterval(iv);mus.pause()}else mus.volume=v},60)}
    if(actx&&master){master.gain.cancelScheduledValues(actx.currentTime);master.gain.setValueAtTime(Math.max(master.gain.value,.0001),actx.currentTime);master.gain.exponentialRampToValueAtTime(.0001,actx.currentTime+.6);setTimeout(function(){try{actx.close()}catch(e){}},900)}
  }catch(e){}
}

/* ---------- akış ---------- */
function finish(){
  if(done)return;done=true;
  try{sessionStorage.setItem('introSeen','1')}catch(e){}
  el.classList.add('out');cancelAnimationFrame(raf);
  try{vid.pause()}catch(e){}
  stopMusic();
  document.body.style.overflow='';
  setTimeout(function(){el.remove()},900);
}
document.getElementById('introSkip').onclick=finish;
var go=document.getElementById('introGo'),started=false;
function startShow(){
  if(done||started)return;started=true;
  load.style.opacity=0;load.style.pointerEvents='none';
  if(VIDEO_SRC){
    cv.style.display='none';vid.style.display='block';vid.src=VIDEO_SRC;
    vid.onended=finish;vid.onerror=finish;
    var p=vid.play();
    if(p&&p.catch)p.catch(function(){vid.muted=true;vid.play().catch(finish)});
  }else{
    phase=1;flightStart=performance.now();playMusic();
    setTimeout(function(){if(done)return;phase=2;flashT=performance.now();show.classList.add('on')},FLIGHT_MS);
    setTimeout(finish,FLIGHT_MS+TITLE_MS);
  }
}
if(MUSIC_ON||VIDEO_SRC){
  setTimeout(function(){if(!started&&!done){go.style.display='inline-block'}},LOAD_MS);
  go.onclick=startShow;
}else{setTimeout(startShow,LOAD_MS)}
})();
