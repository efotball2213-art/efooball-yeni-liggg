var cx=cv.getContext('2d'),W=0,H=0,dpr=1,S=1,OX=0,OY=0,rnd=Math.random;
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
function size(){dpr=Math.min(window.devicePixelRatio||1,1.25);W=innerWidth;H=innerHeight;
  cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);cx.setTransform(dpr,0,0,dpr,0,0);
  S=Math.max(W/1000,H/1600);OX=(W-1000*S)/2;OY=(H-1600*S)/2}
size();addEventListener('resize',size);
function X(x){return OX+x*S}function Y(y){return OY+y*S}
/* dizilişler: takım 0 (turuncu) yukarı, takım 1 (beyaz) aşağı atak yapar */
var FORM=[
 [[500,1470],[170,1260],[390,1280],[610,1280],[830,1260],[170,1020],[390,1040],[610,1040],[830,1020],[380,780],[620,780]],
 [[500,130],[170,340],[390,320],[610,320],[830,340],[250,590],[500,570],[750,590],[200,830],[500,860],[800,830]]
];
var P=[];
FORM.forEach(function(f,t){f.forEach(function(h,i){P.push({t:t,i:i,hx:h[0],hy:h[1],x:h[0],y:h[1],ph:rnd()*9,gk:i===0})})});
function pid(t,i){return t*11+i}
var B={x:500,y:800,sx:500,sy:800,tx:0,ty:0,t:0,dur:1,mode:'hold',holder:pid(0,9),team:0,wait:.8,recv:-1,out:'goal',trail:[]};
var sparks=[],rings=[],golT=-1,golX=0,golY=0,time=0,goals=[0,0];
var parts=[];for(var i=0;i<46;i++)parts.push({x:rnd(),y:rnd(),v:.008+rnd()*.03,r:.8+rnd()*1.8,ph:rnd()*9});
function ease(t){return t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2}
function dist(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}
function nearestOpp(team,x,y){var best=-1,bd=1e9;for(var i=1;i<11;i++){var p=P[pid(1-team,i)],d=Math.hypot(p.x-x,p.y-y);if(d<bd){bd=d;best=pid(1-team,i)}}return best}
function celebrate(x,y){
  golT=0;golX=x;golY=y;rings.push({x:x,y:y,r:10,a:.9});rings.push({x:x,y:y,r:10,a:.6,v:1.5});
  var cols=['#ff6a2b','#ffd23f','#f3f6ee'];
  for(var i=0;i<34;i++){var a=rnd()*Math.PI*2,v=120+rnd()*380;sparks.push({x:x,y:y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:1,c:cols[i%3]})}
}
function update(dt){
  time+=dt;
  var bx=B.x,by=B.y;
  P.forEach(function(p){
    var k=p.gk?.03:.16,push=(B.team===p.t&&!p.gk)?(p.t===0?-70:70):0;
    var tx=p.hx+(bx-p.hx)*k+Math.sin(time*.9+p.ph)*14,ty=p.hy+(by-p.hy)*k+push+Math.cos(time*.7+p.ph*1.3)*14;
    if(!p.gk&&(B.mode==='pass'&&p.i&&pid(p.t,p.i)===B.recv)){tx=B.x+(p.t?-1:1)*0;ty=B.y}
    tx=Math.max(70,Math.min(930,tx));ty=Math.max(70,Math.min(1530,ty));
    var q=Math.min(1,dt*(pid(p.t,p.i)===B.holder?3:1.7));p.x+=(tx-p.x)*q;p.y+=(ty-p.y)*q;
  });
  var h=P[B.holder];
  if(B.mode==='hold'){
    B.x=h.x;B.y=h.y;B.wait-=dt;
    if(B.wait<=0){
      var att=B.team===0?h.y<470:h.y>1130;
      if(att&&rnd()<.92){
        var r=rnd();B.out=r<.5?'goal':r<.82?'save':'wide';
        B.sx=B.x;B.sy=B.y;B.tx=500+(rnd()-.5)*(B.out==='wide'?520:110);B.ty=B.team===0?40:1560;
        B.t=0;B.dur=.55;B.mode='shot';
      }else{
        var c=[];for(var i=1;i<11;i++){var id=pid(B.team,i);if(id===B.holder)continue;var p=P[id],fw=(B.team===0?-1:1)*(p.y-h.y);c.push({id:id,s:fw*.8-Math.abs(p.x-h.x)*.15-dist(p,h)*.2+rnd()*260})}
        c.sort(function(a,b){return b.s-a.s});
        var pick=rnd()<.12?pid(B.team,0):c[Math.floor(rnd()*Math.min(3,c.length))].id;
        B.recv=pick;B.sx=B.x;B.sy=B.y;B.t=0;B.dur=.5+dist(P[pick],h)/1500;B.mode='pass';
      }
    }
  }else if(B.mode==='pass'){
    B.t+=dt/B.dur;var r=P[B.recv],e=ease(Math.min(1,B.t));B.x=B.sx+(r.x-B.sx)*e;B.y=B.sy+(r.y-B.sy)*e;
    if(B.t>=1){
      if(rnd()<.13){var o=nearestOpp(B.team,B.x,B.y);B.team=1-B.team;B.holder=o}else B.holder=B.recv;
      B.mode='hold';B.wait=.35+rnd()*.8;
    }
  }else if(B.mode==='shot'){
    B.t+=dt/B.dur;var e2=Math.min(1,B.t);B.x=B.sx+(B.tx-B.sx)*e2;B.y=B.sy+(B.ty-B.sy)*e2;
    if(B.t>=1){
      if(B.out==='goal'){goals[B.team]++;celebrate(B.tx,B.ty);B.mode='goal';B.wait=1.9}
      else{B.team=1-B.team;B.holder=pid(B.team,0);B.mode='hold';B.wait=.9}
    }
  }else if(B.mode==='goal'){
    B.wait-=dt;
    if(B.wait<=0){B.team=1-B.team;B.holder=pid(B.team,9);B.x=500;B.y=800;B.trail.length=0;B.mode='hold';B.wait=.9}
  }
  B.trail.push(B.x,B.y);if(B.trail.length>28)B.trail.splice(0,2);
  if(golT>=0){golT+=dt;if(golT>1.9)golT=-1}
  for(var s=sparks.length-1;s>=0;s--){var sp=sparks[s];sp.x+=sp.vx*dt;sp.y+=sp.vy*dt;sp.vx*=.97;sp.vy=sp.vy*.97+120*dt;sp.l-=dt*.9;if(sp.l<=0)sparks.splice(s,1)}
  for(var q2=rings.length-1;q2>=0;q2--){var g=rings[q2];g.r+=dt*(g.v?700:420);g.a-=dt*.7;if(g.a<=0)rings.splice(q2,1)}
  parts.forEach(function(p){p.y-=p.v*dt;p.x+=Math.sin(time*.6+p.ph)*.0002;if(p.y<-.02){p.y=1.02;p.x=rnd()}});
}
function draw(){
  cx.clearRect(0,0,W,H);cx.globalCompositeOperation='source-over';
  /* akan çim şeritleri */
  var off=(time*9)%180;cx.fillStyle='rgba(255,255,255,.035)';
  for(var x=-180+off;x<W;x+=180)cx.fillRect(x,0,90,H);
  /* projektör ışık huzmeleri */
  cx.globalCompositeOperation='lighter';
  [[.1,0,.2],[.5,2.1,0],[.9,4.2,-.2]].forEach(function(b){
    var ang=Math.sin(time*.33+b[1])*.26+b[2],L=H*1.35,w=H*.34,pulse=.75+.25*Math.sin(time*.8+b[1]);
    cx.save();cx.translate(b[0]*W,-20);cx.rotate(ang);
    var g=cx.createLinearGradient(0,0,0,L);g.addColorStop(0,'rgba(255,250,215,'+(.17*pulse)+')');g.addColorStop(1,'rgba(255,250,215,0)');
    cx.fillStyle=g;cx.beginPath();cx.moveTo(0,0);cx.lineTo(-w,L);cx.lineTo(w,L);cx.closePath();cx.fill();cx.restore();
  });
  /* kayan ışık dalgası */
  var cyc=(time%11)/11,bx=-W*.4+cyc*W*1.8,sg=cx.createLinearGradient(bx-W*.25,0,bx+W*.25,H*.4);
  sg.addColorStop(0,'rgba(255,255,255,0)');sg.addColorStop(.5,'rgba(255,255,255,.06)');sg.addColorStop(1,'rgba(255,255,255,0)');
  cx.fillStyle=sg;cx.fillRect(0,0,W,H);
  cx.globalCompositeOperation='source-over';
  /* pas çizgisi + top izi */
  if(B.mode==='pass'||B.mode==='shot'){
    cx.strokeStyle='rgba(255,255,255,.25)';cx.lineWidth=Math.max(1,2*S);cx.setLineDash([8*S,8*S]);
    cx.beginPath();cx.moveTo(X(B.sx),Y(B.sy));cx.lineTo(X(B.mode==='pass'?P[B.recv].x:B.tx),Y(B.mode==='pass'?P[B.recv].y:B.ty));cx.stroke();cx.setLineDash([]);
  }
  var tr=B.trail;
  for(var i=2;i<tr.length;i+=2){cx.strokeStyle='rgba(255,255,255,'+(.5*i/tr.length)+')';cx.lineWidth=Math.max(1.5,5*S*i/tr.length);cx.beginPath();cx.moveTo(X(tr[i-2]),Y(tr[i-1]));cx.lineTo(X(tr[i]),Y(tr[i+1]));cx.stroke()}
  /* oyuncular */
  var pr=Math.max(6,11*S);
  P.forEach(function(p){
    var col=p.t?'243,246,238':'255,106,43',hold=pid(p.t,p.i)===B.holder&&B.mode!=='goal';
    cx.fillStyle='rgba('+col+',.16)';cx.beginPath();cx.arc(X(p.x),Y(p.y),pr*2,0,7);cx.fill();
    cx.fillStyle='rgba('+col+',.88)';cx.beginPath();cx.arc(X(p.x),Y(p.y),pr,0,7);cx.fill();
    if(hold){cx.strokeStyle='rgba(255,210,63,.9)';cx.lineWidth=2;cx.beginPath();cx.arc(X(p.x),Y(p.y),pr*1.7,0,7);cx.stroke()}
  });
  /* top */
  var br=Math.max(4,7*S);cx.fillStyle='rgba(255,255,255,.22)';cx.beginPath();cx.arc(X(B.x),Y(B.y),br*2.6,0,7);cx.fill();
  cx.fillStyle='#fff';cx.beginPath();cx.arc(X(B.x),Y(B.y),br,0,7);cx.fill();
  cx.strokeStyle='#111';cx.lineWidth=1;cx.beginPath();cx.arc(X(B.x),Y(B.y),br,0,7);cx.stroke();
  /* toz / ışık parçacıkları */
  cx.globalCompositeOperation='lighter';
  parts.forEach(function(p){var a=.12+.22*Math.abs(Math.sin(time*.9+p.ph));cx.fillStyle='rgba(255,250,210,'+a+')';cx.beginPath();cx.arc(p.x*W,p.y*H,p.r,0,7);cx.fill()});
  /* gol efektleri */
  rings.forEach(function(g){cx.strokeStyle='rgba(255,210,63,'+Math.max(0,g.a)+')';cx.lineWidth=4*S+2;cx.beginPath();cx.arc(X(g.x),Y(g.y),g.r*S,0,7);cx.stroke()});
  sparks.forEach(function(s){cx.fillStyle=s.c;cx.globalAlpha=Math.max(0,s.l);cx.beginPath();cx.arc(X(s.x),Y(s.y),Math.max(2,3.5*S),0,7);cx.fill()});
  cx.globalAlpha=1;
  if(golT>=0){
    var a2=golT<.25?golT/.25:Math.max(0,1-(golT-.25)/1.6);
    cx.globalCompositeOperation='source-over';
    cx.fillStyle='rgba(255,210,63,'+(.07*a2)+')';cx.fillRect(0,0,W,H);
    cx.font='900 '+Math.round(330*S)+'px "Big Shoulders Display",Impact,sans-serif';cx.textAlign='center';cx.textBaseline='middle';
    cx.fillStyle='rgba(255,210,63,'+(.2*a2)+')';cx.fillText('GOL!',W/2,H*.5);
  }
  cx.globalCompositeOperation='source-over';
}
var last=0;
function loop(now){
  requestAnimationFrame(loop);
  var dt=Math.min(.05,(now-last)/1000);last=now;
  if(document.hidden||document.getElementById('intro'))return;
  update(dt);draw();
}
if(reduce){update(.016);draw()}else requestAnimationFrame(loop);
})();
</script>
</body>
