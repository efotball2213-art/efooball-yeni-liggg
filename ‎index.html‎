  if(ia)out.push(a);if(ia!==ib){var t=(NEAR-a[2])/(b[2]-a[2]);out.push([a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,NEAR])}}return out}
function fillPoly(w,color){
  var c=clipPoly(w.map(cam));if(c.length<3)return;
  cx.fillStyle=color;cx.beginPath();
  for(var i=0;i<c.length;i++){var s=sc(c[i]);if(i)cx.lineTo(s[0],s[1]);else cx.moveTo(s[0],s[1])}
  cx.closePath();cx.fill();
}
function seg(a,b,wm,minpx){
  if(a[2]<NEAR&&b[2]<NEAR)return;
  if(a[2]<NEAR){var t=(NEAR-a[2])/(b[2]-a[2]);a=[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,NEAR]}
  else if(b[2]<NEAR){var u=(NEAR-b[2])/(a[2]-b[2]);b=[b[0]+(a[0]-b[0])*u,b[1]+(a[1]-b[1])*u,NEAR]}
  var s1=sc(a),s2=sc(b);
  cx.lineWidth=Math.min(40,Math.max(minpx,f*wm/((a[2]+b[2])/2)));
  cx.beginPath();cx.moveTo(s1[0],s1[1]);cx.lineTo(s2[0],s2[1]);cx.stroke();
}
function poly3(pts,color,wm,minpx,colorFn){
  cx.strokeStyle=color;cx.lineCap='round';
  var cs=pts.map(cam);
  for(var i=0;i<cs.length-1;i++){if(colorFn)cx.strokeStyle=colorFn(i);seg(cs[i],cs[i+1],wm,minpx)}
}
function glow(p,size,alpha){
  var c=cam(p);if(c[2]<1)return;var s=sc(c),r=Math.min(380,Math.max(5,f*size/c[2]));
  if(s[0]<-r||s[0]>W+r||s[1]<-r||s[1]>H+r)return;
