      var dx=arr[k]-C[0],dy=arr[k+1]-C[1],dz=arr[k+2]-C[2];
      var z=dx*Fv[0]+dy*Fv[1]+dz*Fv[2];if(z<1)continue;
      var sx=W/2+f*(dx*Rv[0]+dy*Rv[1]+dz*Rv[2])/z;if(sx<-6||sx>W+6)continue;
      var sy=H/2-f*(dx*Uv[0]+dy*Uv[1]+dz*Uv[2])/z;if(sy<-6||sy>H+6)continue;
