    fr.forEach(function(fq){[-7,7].forEach(function(dt){
      var o=actx.createOscillator(),g=actx.createGain();o.type='sawtooth';o.frequency.value=fq;o.detune.value=dt;
      g.gain.setValueAtTime(.0001,st);g.gain.exponentialRampToValueAtTime(vol,st+att);g.gain.exponentialRampToValueAtTime(.0001,st+dur);
      o.connect(g);g.connect(lp);o.start(st);o.stop(st+dur+.05)})});
  }
