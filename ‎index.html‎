<title>eFootball Lig</title>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--turf:#0d5c35;--turf2:#08412a;--chalk:#f3f6ee;--ink:#06130c;--flare:#ff6a2b;--sun:#ffd23f;--dim:rgba(243,246,238,.62);--ln:rgba(243,246,238,.2);--glass:rgba(6,19,12,.55)}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--turf2)}
body{margin:0;color:var(--chalk);font:500 15px/1.45 'DM Sans',system-ui,sans-serif;min-height:100vh;background:repeating-linear-gradient(90deg,rgba(255,255,255,.04) 0 90px,transparent 90px 180px),radial-gradient(120% 80% at 50% 0,var(--turf),var(--turf2));background-attachment:fixed;-webkit-tap-highlight-color:transparent;overflow-x:hidden}
button,input,select,textarea{font:inherit}button{touch-action:manipulation}
.pitch{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.5}
.pitch *{fill:none;stroke:var(--chalk);stroke-width:2;stroke-dasharray:2400;stroke-dashoffset:2400;animation:draw 2.6s .2s cubic-bezier(.6,0,.2,1) forwards;vector-effect:non-scaling-stroke}
@keyframes draw{to{stroke-dashoffset:0}}
#fx{position:fixed;inset:0;z-index:500;pointer-events:none}
#app{position:relative;z-index:1}
.wrap{max-width:900px;margin:0 auto;padding:18px 16px 170px}
.top{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--dim)}
.tag{font-weight:700;letter-spacing:.04em;padding:4px 10px;border:1.5px solid var(--chalk);border-radius:6px;color:var(--chalk)}
h1{font:900 clamp(56px,17vw,128px)/.86 'Big Shoulders Display',Impact,sans-serif;text-transform:uppercase;margin:18px 0 8px;letter-spacing:-.01em;display:flex;flex-wrap:wrap;gap:0 .18em}
h1 span{display:inline-block;transform:translateY(110%) rotate(6deg);opacity:0;animation:up .8s cubic-bezier(.2,1.1,.3,1) forwards}
@keyframes up{to{transform:none;opacity:1}}
h1 em{font-style:normal;color:var(--flare)}
.sub{color:var(--dim);margin:0 0 18px;max-width:46ch}
.ball{position:absolute;right:-60px;top:70px;font-size:44px;animation:roll 3s 1.2s cubic-bezier(.3,.7,.3,1) forwards;opacity:0}
@keyframes roll{0%{opacity:1;transform:translateX(0) rotate(0)}100%{opacity:1;transform:translateX(calc(-100vw + 120px)) rotate(-900deg)}}
.strip{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{background:var(--glass);border:1.5px solid var(--ln);border-radius:16px;padding:12px 14px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.tile small{display:block;font-size:11px;color:var(--dim);font-weight:700;letter-spacing:.06em}
.tile b{display:block;font:900 26px/1.1 'Big Shoulders Display';text-transform:uppercase;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tile.hot{background:var(--flare);border-color:transparent;color:var(--ink)}.tile.hot small{color:rgba(6,19,12,.7)}
.ticker{margin:16px -16px 0;background:var(--ink);overflow:hidden;white-space:nowrap;border-block:1.5px solid var(--ln);padding:8px 0}
.ticker div{display:inline-block;padding-left:100%;animation:tk 28s linear infinite;font-weight:700;font-size:13px}.ticker b{color:var(--sun);margin:0 10px}
@keyframes tk{to{transform:translateX(-100%)}}
.champ{margin-top:16px;background:var(--sun);color:var(--ink);border-radius:18px;padding:16px;display:flex;align-items:center;gap:14px;animation:pl 2s ease-in-out infinite}
@keyframes pl{50%{transform:scale(1.02);box-shadow:0 0 0 10px rgba(255,210,63,.18)}}
.champ i{font-size:40px;font-style:normal}.champ small{font-weight:700;letter-spacing:.08em;font-size:11px}.champ b{display:block;font:900 34px/1 'Big Shoulders Display';text-transform:uppercase}
.sec{font:900 32px 'Big Shoulders Display';text-transform:uppercase;margin:28px 0 12px;display:flex;align-items:center;gap:12px}.sec::after{content:"";flex:1;border-top:2px dashed var(--ln)}
.row{position:relative;display:grid;grid-template-columns:44px 1fr auto;gap:10px;align-items:center;padding:12px 14px;margin-bottom:8px;border-radius:16px;background:var(--glass);border:1.5px solid var(--ln);overflow:hidden;cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:transform .2s,border-color .2s}
.row:hover{transform:translateX(5px);border-color:var(--chalk)}
.row .fill{position:absolute;inset:0 auto 0 0;width:0;background:linear-gradient(90deg,rgba(255,106,43,.5),rgba(255,106,43,.05));transition:width 1.3s cubic-bezier(.2,.8,.2,1);z-index:0}
.row>*{position:relative;z-index:1}.row.first{border-color:var(--flare)}
.pos{font:900 40px/1 'Big Shoulders Display';color:var(--chalk);text-align:center}.row.first .pos{color:var(--flare)}
.nm{font-weight:700;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mini{font-size:12px;color:var(--dim);display:flex;gap:10px;align-items:center;margin-top:2px}
.form i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:3px;background:var(--sun)}.form i.l{background:transparent;border:1.5px solid var(--dim)}
.pts{font:900 44px/1 'Big Shoulders Display';text-align:right}.pts small{display:block;font:700 10px 'DM Sans';color:var(--dim);letter-spacing:.08em}
.wk{position:sticky;top:0;z-index:5;font:900 20px 'Big Shoulders Display';text-transform:uppercase;padding:8px 0;margin-top:14px;background:linear-gradient(var(--turf2) 70%,transparent)}
.match{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;padding:14px;margin-bottom:8px;border-radius:16px;background:var(--glass);border:1.5px solid var(--ln);cursor:pointer;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.tm{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tm.r{text-align:right}.tm.w{color:var(--sun);text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:5px;text-decoration-color:var(--flare)}
.sb{display:flex;gap:4px;justify-content:center}.dg{background:var(--ink);border-radius:8px;min-width:38px;padding:2px 6px;text-align:center;font:900 38px/1.1 'Big Shoulders Display';animation:flip .7s cubic-bezier(.3,1.4,.4,1) backwards}
@keyframes flip{from{transform:rotateX(-90deg);opacity:0}}
.vs{font:900 22px 'Big Shoulders Display';color:var(--dim);text-align:center}.bd{display:block;text-align:center;font-size:10px;font-weight:700;color:var(--sun);margin-top:4px;letter-spacing:.06em}
.bar{height:10px;border-radius:99px;background:rgba(0,0,0,.3);margin-top:6px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:var(--flare);border-radius:99px;transition:width 1.2s cubic-bezier(.2,.8,.2,1)}
.lr{padding:11px 0;border-top:1px dashed var(--ln)}.lr:first-child{border-top:0}.lr .t{display:flex;justify-content:space-between;gap:8px;font-weight:700}
.box{padding:6px 16px;border-radius:16px;background:var(--glass);border:1.5px solid var(--ln)}
.news{padding:14px 16px;margin-bottom:8px;border-radius:16px;background:var(--glass);border:1.5px solid var(--ln)}.news.pin{border-color:var(--sun)}.news small{color:var(--dim);display:block;margin-bottom:3px}
.chips{display:flex;gap:6px;overflow-x:auto;padding:2px 0 12px}.chip{flex:none;border:1.5px solid var(--ln);background:var(--glass);color:var(--chalk);border-radius:99px;padding:7px 13px;font-weight:700;font-size:13px;cursor:pointer}.chip.on{background:var(--chalk);color:var(--ink);border-color:transparent}.chip.fv.on{background:var(--flare)}
.lgh{font:900 18px 'Big Shoulders Display';text-transform:uppercase;color:var(--sun);margin:16px 0 6px}
.lm .ts{display:flex;align-items:center;gap:8px;min-width:0}.lm .ts.r{flex-direction:row-reverse}.lm .ts img{width:26px;height:26px;object-fit:contain;flex:none}.lm .ts span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:700}
.lm.fav{border-color:var(--flare)}.lm.on{border-color:#ff5252}.lvb{color:#ff6b6b!important;animation:bl 1.2s infinite}.hint2{font-size:12px;color:var(--dim);margin-top:14px}
.empty{padding:30px;text-align:center;color:var(--dim);border:2px dashed var(--ln);border-radius:16px}
.foot{text-align:center;color:var(--dim);font-size:12px;margin-top:36px}.foot button{background:none;border:0;color:var(--dim);text-decoration:underline;padding:10px;cursor:pointer}
.live{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--sun);margin-right:6px;animation:bl 1.3s infinite}.live.off{background:#777;animation:none}@keyframes bl{50%{opacity:.2}}
.bar2{position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:50;display:flex;gap:4px;padding:6px;background:var(--ink);border:1.5px solid var(--ln);border-radius:22px;box-shadow:0 14px 40px rgba(0,0,0,.5);width:min(440px,calc(100% - 24px))}
.bar2 button{flex:1;border:0;background:none;color:var(--dim);padding:8px 2px;border-radius:16px;font-size:11px;font-weight:700;cursor:pointer;transition:.25s;display:flex;flex-direction:column;align-items:center;gap:1px}
.bar2 button span{font-size:20px;transition:transform .3s cubic-bezier(.3,1.6,.4,1)}.bar2 button.on{background:var(--flare);color:var(--ink)}.bar2 button.on span{transform:translateY(-3px) scale(1.2)}
.mute.bell{right:58px}
.mute{position:fixed;top:12px;right:12px;z-index:50;width:40px;height:40px;border-radius:50%;border:1.5px solid var(--ln);background:var(--glass);color:var(--chalk);cursor:pointer;font-size:16px}
.fab{position:fixed;right:14px;bottom:calc(86px + env(safe-area-inset-bottom,0px));z-index:50}
.btn{border:1.5px solid var(--chalk);background:transparent;color:var(--chalk);padding:10px 16px;border-radius:12px;font-weight:700;cursor:pointer;min-height:44px;transition:.2s}.btn:active{transform:scale(.96)}
.btn.primary{background:var(--flare);border-color:transparent;color:var(--ink)}.btn.danger{border-color:#ff7a70;color:#ff7a70}.btn.sm{padding:6px 12px;min-height:36px;font-size:13px}
.modal{position:fixed;inset:0;z-index:150;background:rgba(0,0,0,.7);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);display:flex;align-items:flex-end;justify-content:center;animation:fd .2s}
@keyframes fd{from{opacity:0}}
.dlg{width:min(460px,100%);max-height:92vh;overflow:auto;background:var(--ink);border:1.5px solid var(--ln);border-radius:26px 26px 0 0;padding:22px 20px calc(22px + env(safe-area-inset-bottom,0px));animation:sh .45s cubic-bezier(.2,1,.3,1)}
@keyframes sh{from{transform:translateY(100%)}}
.dlg h2{font:900 38px/1 'Big Shoulders Display';text-transform:uppercase;margin:0 0 4px}.dlg p{color:var(--dim);margin:0 0 12px}.err{color:#ff7a70;min-height:20px;margin:6px 0;font-size:13px}
.btns{display:flex;gap:10px;margin-top:10px}.btns .btn{flex:1}.shake{animation:sk .35s}@keyframes sk{25%{transform:translateX(-9px)}75%{transform:translateX(9px)}}
.stat{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.stat div{background:var(--glass);border:1.5px solid var(--ln);border-radius:12px;padding:8px 4px;text-align:center}.stat b{display:block;font:900 30px/1 'Big Shoulders Display';color:var(--sun)}.stat span{font-size:10px;color:var(--dim)}
.toast{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:600;background:var(--chalk);color:var(--ink);font-weight:700;padding:11px 18px;border-radius:99px;max-width:calc(100% - 28px);text-align:center;animation:tin .4s cubic-bezier(.2,1.4,.4,1)}@keyframes tin{from{transform:translate(-50%,-40px);opacity:0}}
.panel{position:fixed;inset:0;z-index:120;background:var(--ink);display:flex;flex-direction:column;animation:fd .2s}
.ph{display:flex;align-items:center;gap:8px;padding:10px 12px;border-bottom:1.5px solid var(--ln)}.ph .ttl{font:900 24px 'Big Shoulders Display';text-transform:uppercase;flex:1}
.pt{display:flex;gap:6px;padding:8px 12px;overflow-x:auto;border-bottom:1.5px solid var(--ln)}.pt button{border:1.5px solid var(--ln);background:none;color:var(--chalk);border-radius:99px;padding:8px 14px;font-weight:700;white-space:nowrap;cursor:pointer}.pt button.on{background:var(--flare);color:var(--ink);border-color:transparent}
.pb{flex:1;overflow:auto;padding:14px 12px 100px;max-width:760px;width:100%;margin:0 auto}
input,select,textarea{width:100%;background:#0d1f15;color:var(--chalk);border:1.5px solid var(--ln);border-radius:10px;padding:10px 12px;font-size:16px;outline:none;min-height:44px}input:focus,select:focus,textarea:focus{border-color:var(--flare)}
input[type=checkbox]{width:22px;height:22px;min-height:0}input[type=color]{padding:3px}textarea{min-height:90px}
.f{margin-bottom:12px}.lb{display:block;font-size:11px;font-weight:700;letter-spacing:.06em;color:var(--sun);margin-bottom:4px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.ed{background:#0d1f15;border:1.5px solid var(--ln);border-radius:14px;padding:12px;margin-bottom:10px}.r{display:flex;gap:8px;align-items:center;margin-bottom:8px}.sw{display:flex;align-items:center;gap:10px}.hint{font-size:12px;color:var(--dim);margin:6px 0}
.dotd{width:8px;height:8px;border-radius:50%;background:var(--sun);display:inline-block;margin-right:6px}.dotd.dirty{background:var(--flare);animation:bl 1s infinite}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.pitch *{stroke-dashoffset:0}h1 span{opacity:1;transform:none}}

/* ===== GİRİŞ İNTROSU ===== */
#bgfx{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
#intro{position:fixed;inset:0;z-index:9999;background:radial-gradient(90% 70% at 50% 45%,#0b2a6b,#030a1f 70%);display:flex;align-items:center;justify-content:center;flex-direction:column;overflow:hidden;transition:opacity .8s ease,visibility .8s}
#intro.out{opacity:0;visibility:hidden}
#intro canvas{position:absolute;inset:0;width:100%;height:100%}
#introLoad{position:relative;text-align:center;transition:opacity .5s}
#introLoad b{display:block;font:900 clamp(28px,8vw,56px)/1 'Big Shoulders Display',Impact,sans-serif;letter-spacing:.2em;color:#fff;text-transform:uppercase}
#introLoad .bar{width:min(260px,60vw);height:4px;background:rgba(255,255,255,.18);border-radius:4px;margin:16px auto 0;overflow:hidden}
#introLoad .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#7fb2ff,#fff);animation:ilbar 2.2s ease-in-out forwards}
@keyframes ilbar{to{width:100%}}
#introShow{position:absolute;inset:0;text-align:center;opacity:0;pointer-events:none;display:flex;flex-direction:column;align-items:center;justify-content:center}
#introShow.on{opacity:1}
.istar{width:clamp(120px,32vw,200px);height:auto;filter:drop-shadow(0 0 24px rgba(160,200,255,.8));transform:scale(.2) rotate(-180deg);opacity:0}
#introShow.on .istar{animation:istar 1.4s cubic-bezier(.2,1.2,.3,1) forwards}
@keyframes istar{to{transform:none;opacity:1}}
.ititle{font:900 clamp(34px,11vw,92px)/.95 'Big Shoulders Display',Impact,sans-serif;letter-spacing:.06em;text-transform:uppercase;margin:14px 0 0;color:#fff;background:linear-gradient(100deg,#fff 40%,#9cc4ff 50%,#fff 60%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;opacity:0;transform:translateY(24px)}
#introShow.on .ititle{animation:ititle 1s .7s ease forwards,ishine 2.2s 1.6s ease-in-out forwards}
@keyframes ititle{to{opacity:1;transform:none}}
@keyframes ishine{from{background-position:120% 0}to{background-position:-60% 0}}
.isub{margin-top:8px;font:700 13px 'DM Sans',sans-serif;letter-spacing:.5em;color:#9cc4ff;opacity:0}
#introShow.on .isub{animation:ititle 1s 1.2s ease forwards}
#introVid{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;display:none}
#introGo{margin-top:22px;background:#fff;color:#0b2a6b;border:0;border-radius:999px;padding:12px 26px;font:900 18px 'Big Shoulders Display',Impact,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;display:none;animation:igo 1.4s ease-in-out infinite}
@keyframes igo{50%{transform:scale(1.07);box-shadow:0 0 28px rgba(160,200,255,.8)}}
#introSkip{position:absolute;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:8px 16px;font-weight:700;cursor:pointer;z-index:2}
</style>
</head>
<body>

<div id="intro" aria-label="Giriş">
<canvas id="introFx"></canvas>
<video id="introVid" playsinline preload="auto"></video>
<div id="introLoad"><b>Yükleniyor</b><div class="bar"><i></i></div><button id="introGo" type="button">&#9835; Giri&#351; i&ccedil;in dokun</button></div>
<div id="introShow">
<svg class="istar" viewBox="-50 -50 100 100" aria-hidden="true"><circle r="44" fill="#fff"/><circle r="44" fill="none" stroke="#0b2a6b" stroke-width="2"/><polygon fill="#0b2a6b" points="0,-18 5.3,-7.3 17.1,-5.6 8.5,2.8 10.6,14.6 0,9 -10.6,14.6 -8.5,2.8 -17.1,-5.6 -5.3,-7.3"/><g fill="#0b2a6b"><polygon points="0,-40 3,-31 -3,-31"/><polygon points="38,-12 29,-9 31,-15"/><polygon points="23,32 20,23 26,24"/><polygon points="-23,32 -26,24 -20,23"/><polygon points="-38,-12 -31,-15 -29,-9"/></g></svg>
<h2 class="ititle" id="introTitle">Şampiyonlar Ligi</h2>
<div class="isub" id="introSub">Hoş geldin</div>
</div>
<button id="introSkip" type="button">Geç ›</button>
</div>
<canvas id="bgfx"></canvas>
<svg class="pitch" viewBox="0 0 1000 1600" preserveAspectRatio="xMidYMid slice"><rect x="40" y="40" width="920" height="1520"/><path d="M40 800H960"/><circle cx="500" cy="800" r="150"/><rect x="250" y="40" width="500" height="260"/><rect x="250" y="1300" width="500" height="260"/><rect x="380" y="40" width="240" height="100"/><rect x="380" y="1460" width="240" height="100"/></svg>
<canvas id="fx"></canvas>
<script>window.onerror=function(m,s,l){var a=document.getElementById('app');if(a)a.innerHTML='<div style="padding:40px;text-align:center">Hata: '+m+' (satır '+l+')</div>'}</script>
<script>
/* ===== BİLDİRİM (PUSH) MODÜLÜ ===== */
(function(){
/* ---- PUSH AYARLARI (kurulumdan sonra doldur) ---- */
var CFG={
  APP_ID:'',      // OneSignal App ID  (örn: 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx')
  WORKER_URL:''   // Cloudflare Worker adresi (örn: 'https://lig-push.kullanici.workers.dev')
};
/* ------------------------------------------------- */
var P=window.EFLPush={on:false,ready:false,subscribed:false};
var secure=location.protocol==='https:'||location.hostname==='localhost'||location.hostname==='127.0.0.1';
P.on=!!(CFG.APP_ID&&secure);
P.getKey=function(){try{return localStorage.getItem('efl_push_key')||''}catch(e){return ''}};
P.setKey=function(k){try{localStorage.setItem('efl_push_key',k)}catch(e){}};
if(!P.on)return;
window.OneSignalDeferred=window.OneSignalDeferred||[];
var s=document.createElement('script');s.src='https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js';s.defer=true;document.head.appendChild(s);
OneSignalDeferred.push(function(OS){
  OS.init({appId:CFG.APP_ID,serviceWorkerPath:'OneSignalSDKWorker.js',notifyButton:{enable:false},allowLocalhostAsSecureOrigin:true}).then(function(){
    P.OS=OS;P.ready=true;P.subscribed=!!OS.User.PushSubscription.optedIn;
    OS.User.PushSubscription.addEventListener('change',function(e){P.subscribed=!!(e.current&&e.current.optedIn);if(P.onchange)P.onchange()});
    if(P.onchange)P.onchange();
  }).catch(function(){});
});
P.toggle=function(){
  var ios=/iPad|iPhone|iPod/.test(navigator.userAgent);
  if(ios&&!('PushManager' in window))return Promise.resolve('iPhone’da: Safari’de Paylaş → Ana Ekrana Ekle yap, sonra siteyi oradan aç ve 🔔’e bas.');
  if(!P.ready)return Promise.resolve('Bildirim sistemi yükleniyor, birkaç saniye sonra tekrar dene.');
  if(P.subscribed){return Promise.resolve(P.OS.User.PushSubscription.optOut()).then(function(){P.subscribed=false;return 'Bildirimler kapatıldı'})}
  return Promise.resolve(P.OS.Notifications.requestPermission()).then(function(){
    return P.OS.User.PushSubscription.optIn();
  }).then(function(){
    P.subscribed=!!P.OS.User.PushSubscription.optedIn;
    return P.subscribed?'Bildirimler açıldı 🔔':'İzin verilmedi. Tarayıcı ayarlarından bildirime izin ver.';
  }).catch(function(){return 'Bildirim açılamadı'});
};
P.send=function(title,body){
  var key=P.getKey();
  if(!CFG.WORKER_URL)return Promise.resolve('WORKER_URL boş, kurulum tamamlanmamış.');
