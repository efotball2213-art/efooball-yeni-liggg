/* ---------- kamera yolu ---------- */
var K=[[-175,95,-140,0,6,0],[-112,52,-92,0,2,0],[-68,17,-46,6,1,0],[-30,2.9,-10,0,.8,0],[-2.1,.68,-.15,0,.36,0]];
