/* tribün: seyirci noktaları (4 renk grubu) */
var SC=['#1f2f5a','#5a2230','#8b90a8','#f0e2b0'],seatArr=[[],[],[],[]];
(function(){
  for(var i=0;i<22;i++){
    var d=7+i*1.2,a=PL+d,b=PW+d,r=14+i*.8,y=1.2+i*.95+(i>13?(i-13)*.7:0);
