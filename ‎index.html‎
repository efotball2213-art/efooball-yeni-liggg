  chord([73.42,146.83,220,293.66,369.99,440,587.33],t0+fl,tot-fl,.075,.04);
  kick(t0+fl,1);kick(t0+fl+.02,.8);
  var rs=actx.createBufferSource(),bp=actx.createBiquadFilter(),rg=actx.createGain();
  rs.buffer=noiseBuf(fl+.3);bp.type='bandpass';bp.Q.value=1.1;
  bp.frequency.setValueAtTime(400,t0);bp.frequency.exponentialRampToValueAtTime(5200,t0+fl);
