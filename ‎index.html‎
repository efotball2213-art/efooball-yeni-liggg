})();
var allSeats=[];seatArr.forEach(function(a){for(var i=0;i<a.length;i+=3)allSeats.push(a[i],a[i+1],a[i+2])});
/* saha çizgileri */
var LINES=[];
LINES.push([[-PL,.02,-PW],[PL,.02,-PW],[PL,.02,PW],[-PL,.02,PW],[-PL,.02,-PW]]);
LINES.push([[0,.02,-PW],[0,.02,PW]]);
LINES.push(arc(0,0,9.15,0,Math.PI*2,56));
LINES.push(arc(0,0,.35,0,Math.PI*2,10));
[-1,1].forEach(function(s){
  var x=s*PL;
  LINES.push([[x,.02,-20.16],[x-s*16.5,.02,-20.16],[x-s*16.5,.02,20.16],[x,.02,20.16]]);
  LINES.push([[x,.02,-9.16],[x-s*5.5,.02,-9.16],[x-s*5.5,.02,9.16],[x,.02,9.16]]);
  var px=x-s*11,ang=Math.acos(5.5/9.15);
  LINES.push(s<0?arc(px,0,9.15,-ang,ang,16):arc(px,0,9.15,Math.PI-ang,Math.PI+ang,16));
  LINES.push(arc(px,0,.3,0,Math.PI*2,8));
});
var GOALS=[];
[-1,1].forEach(function(s){var x=s*PL,x2=s*(PL+2.2);
  GOALS.push([[x,0,-3.66],[x,2.44,-3.66],[x,2.44,3.66],[x,0,3.66]]);
  GOALS.push([[x,2.44,-3.66],[x2,2.2,-3.66],[x2,0,-3.66]]);
  GOALS.push([[x,2.44,3.66],[x2,2.2,3.66],[x2,0,3.66]]);
  GOALS.push([[x2,0,-3.66],[x2,2.2,-3.66],[x2,2.2,3.66],[x2,0,3.66]]);
});
var BOARDS=ringPts(PL+2.6,PW+2.6,7,.55,150),ROOF=ringPts(PL+36,PW+36,32,36,200);
var LIGHTS=[];[-1,1].forEach(function(sx){[-1,1].forEach(function(sz){LIGHTS.push([sx*(PL+32),46,sz*(PW+32)])})});
var ico=[];(function(){var p=(1+Math.sqrt(5))/2;[[0,1,p],[0,-1,p],[0,1,-p],[0,-1,-p],[1,p,0],[-1,p,0],[1,-p,0],[-1,-p,0],[p,0,1],[-p,0,1],[p,0,-1],[-p,0,-1]].forEach(function(v){var l=Math.hypot(v[0],v[1],v[2]);ico.push([v[0]/l,v[1]/l,v[2]/l])})})();
/* ışık sprite'ı */
var gs=document.createElement('canvas');gs.width=gs.height=128;
(function(){var g=gs.getContext('2d'),gr=g.createRadialGradient(64,64,0,64,64,64);
gr.addColorStop(0,'rgba(255,255,255,1)');gr.addColorStop(.16,'rgba(215,232,255,.7)');gr.addColorStop(.5,'rgba(120,170,255,.18)');gr.addColorStop(1,'rgba(80,130,255,0)');
g.fillStyle=gr;g.fillRect(0,0,128,128)})();
/* yıldızlar (başlık ekranı) */
var stars=[];for(var si=0;si<120;si++)stars.push({x:Math.random(),y:Math.random(),z:Math.random()*.9+.1,t:Math.random()*6});

/* ---------- kamera ---------- */
var C=[0,0,0],Fv=[0,0,1],Rv=[1,0,0],Uv=[0,1,0];
function setCam(a){
  C=[a[0],a[1],a[2]];
  var x=a[3]-a[0],y=a[4]-a[1],z=a[5]-a[2],l=Math.hypot(x,y,z);Fv=[x/l,y/l,z/l];
  var rx=-Fv[2],rz=Fv[0],rl=Math.hypot(rx,rz)||1;Rv=[rx/rl,0,rz/rl];
  Uv=[Rv[1]*Fv[2]-Rv[2]*Fv[1],Rv[2]*Fv[0]-Rv[0]*Fv[2],Rv[0]*Fv[1]-Rv[1]*Fv[0]];
}
function cam(p){var dx=p[0]-C[0],dy=p[1]-C[1],dz=p[2]-C[2];
  return[dx*Rv[0]+dy*Rv[1]+dz*Rv[2],dx*Uv[0]+dy*Uv[1]+dz*Uv[2],dx*Fv[0]+dy*Fv[1]+dz*Fv[2]]}
