/* ---------- müzik (özgün fanfar, ses dosyası gerekmez) ---------- */
var actx=null,master=null,mus=null;
function noiseBuf(sec){var b=actx.createBuffer(1,Math.ceil(actx.sampleRate*sec),actx.sampleRate),d=b.getChannelData(0);for(var i=0;i<d.length;i++)d[i]=Math.random()*2-1;return b}
